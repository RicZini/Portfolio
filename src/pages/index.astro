---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

const works = (await getCollection('works'))
  .sort((a, b) => {
    const byDate = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    return byDate || (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
//
// Calcolo dell'età
//
const birthDate = new Date(2003, 0, 27); // Data di nascita: 27 gennaio 2003
const today = new Date();

let age = today.getFullYear() - birthDate.getFullYear();
const monthDiff = today.getMonth() - birthDate.getMonth();

if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
  age--;
}
---


<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
    <p class="eyebrow">Introduction</p>
    <h1>From Silicon to Code. Engineered for performance.</h1>
    <p class="lead">
      MSc Electronic Engineering student with a solid background spanning analog electronics, RF/MW circuits, IC design and digital architectures.<br>
      Backed by extensive hands-on experience in Formula Student, bridging complex theoretical models with high-performance, real-world execution.
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/works/')}>{t('home.viewWorks')}</a>
      <a class="text-link" href={withBase('/CV_Zini_Riccardo.pdf')} target="_blank">My CV</a>
    </div>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Who am I?</p>
      <h2>The life of a engineer.</h2>
    </div>
    <div class="prose-stack">
      <p>
        I am a {age} year old engineer based in <strong>Veneto, Italy</strong>. When I am not designing circuits, you will probably 
        find me weightlifting, playing basketball, baking traditional Italian desserts, or reading sci-fi and thrillers.
      </p>
      <p>
        My academic journey started in <strong>Automation Engineering</strong>. However, halfway through my BSc, 
        I realized my true passion wasn't just controlling abstract systems, it was designing the physical
        electronics and hardware that powers them. 
        This realization drove my pivot to an MSc in <strong>Electronic Engineering</strong>, where I delved deep into analog and
        mixed-signal electronics as well as RF/MW circuits and IC design.
      </p>
      <p>
        The most formative chapter of my career has been <strong>UniBo Motorsport</strong>. What began as a deep dive into 
        technical implementation evolved into my role as Technical Lead. Managing a department of 12 engineers 
        taught me how to align complex goals with strict deadlines and bridge the gap between theoretical models 
        and race-ready hardware. Today, I continue to support the team as an <strong>alumno</strong>, mentoring the next
        generation of engineers on system architecture, PCB and Powertrain design, and ECU development.
      </p>
    </div>
  </section>

  <section class="section" aria-label={t('about.ledgerLabel')}>
    <div class="about-ledger">
      <article>
        <span>01</span>
        <h3 style="white-space: nowrap;">Relentless curiosity</h3>
        <p>Not afraid of non-linear paths. I pivoted toward electronics out of genuine curiosity, 
          constantly pushing my boundaries and choosing the challenging route to build real expertise.</p>
      </article>
      <article>
        <span>02</span>
        <h3 style="white-space: nowrap;">Research Focus</h3>
        <p>
          Backed by strong academic foundations in analog, digital, and RF electronics. 
          I leverage first-principles theory to tackle complex research and development problems systematically.
        </p>
      </article>
      <article>
        <span>03</span>
        <h3 style="white-space: nowrap;">End-to-End Implementation</h3>
        <p>
          Turning concepts into physical reality using industry-standard tools, spanning Cadence Virtuoso for IC layout, 
          Altium Designer for multi-layer PCBs, and Keysight Advanced Design Software for RF/MW circuit design.
        </p>
      </article>
    </div>
  </section>

  <section class="section split-overview" aria-label={t('home.overviewLabel')}>
    <div>
      <p class="eyebrow">Background</p>
      <h2>My titles and experiences.</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3 style="white-space: nowrap;">BSc in Automation Engineering</h3>
        <p>Focus on control systems and electronic implementations. Thesis on a Formula Student control algorithm.</p>
      </article>
      <article>
        <h3 style="white-space: nowrap;">MSc in Electronic Engineering</h3>
        <p>Specialized in analog and mixed-signal electronics, RF/MW circuits and IC design.</p>
      </article>
      <article>
        <h3 style="white-space: nowrap;">Formula Student - UniBo Motorsport</h3>
        <p>Led the Control Systems department, managing ECU development, Powertrain integration and PCB design.</p>
      </article>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-works">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestWorksEyebrow')}</p>
      <h2 id="latest-works">Built records.</h2>
      <a class="text-link" href={withBase('/works/')}>{t('home.allWorks')}</a>
    </div>

    {
      works.length > 0 ? (
        <div class="highlight-grid">
          {works.map((work) => (
            <article class="highlight-card">
              {work.data.thumbnail && (
                <Image src={work.data.thumbnail} alt="" width={720} height={480} loading="lazy" />
              )}
              <div>
                <p class="meta">{formatDate(work.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/works/${work.id}/`)}>{work.data.title}</a>
                </h3>
                <p>{work.data.description}</p>
                {work.data.tech.length > 0 && (
                  <ul class="tag-list" aria-label={t('home.workTech', { title: work.data.title })}>
                    {work.data.tech.slice(0, 4).map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.worksEmpty')} />
        </div>
      )
    }
  </section>
</BaseLayout>
